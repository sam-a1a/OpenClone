<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws the whole UI, so the platform theme only has to drop the
      action bar and paint a launch background that matches the Compose surface
      (no white flash on cold start). values-night/ supplies the dark variant.
    -->
    <style name="Theme.OpenClone" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
